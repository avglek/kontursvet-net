# ============================================================
# Переменные окружения для docker-compose.*.yml
# Скопируйте в .env и заполните: cp .env.example .env
# .env НЕ коммитится (см. .gitignore)
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=kontursvet
POSTGRES_USER=kontursvet
POSTGRES_PASSWORD=kontursvet
# Внешний порт Postgres на хосте
POSTGRES_PORT=5432

# --- Reverse-proxy nginx (точка входа приложения) ---
# Внешний порт на хосте: http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# --- JWT (подпись токенов админки) ---
# Обязателен в проде, минимум 32 символа
# Сгенерировать: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=kontursvet
JWT_AUDIENCE=kontursvet-admin

# --- Мессенджер MAX (отправка лидов) ---
# Заполнить: без них MaxMessageDispatcher не стартует
MAX_TOKEN=
MAX_CHAT_ID=

# --- Nuxt: базовый URL API для браузера ---
# Пусто = относительные /api/** через nginx (рекомендуется)
NUXT_PUBLIC_API_BASE=

# --- Nuxt: ID счётчика Яндекс Метрики ---
# Пусто = счётчик не подключается (в dev-режиме не работает всегда)
# ВНИМАНИЕ: для docker:prod значение читается на этапе сборки образа (build args
# в docker-compose.prod.yml + Dockerfile.web) — задайте его до `npm run docker:prod:up`
NUXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Nuxt: данные для страницы "Политика конфиденциальности" ---
# Реквизиты ИП, отображаются на странице политики
NUXT_PUBLIC_PRIVACY_FIO=
NUXT_PUBLIC_PRIVACY_INN=
NUXT_PUBLIC_PRIVACY_OGRNIP=
NUXT_PUBLIC_PRIVACY_EMAIL=
