# ============================================================
# Переменные окружения для docker-compose.*.yml
# Скопируйте в .env и заполните: cp .env.example .env
# .env НЕ коммитится (см. .gitignore)
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=kontursvet
POSTGRES_USER=kontursvet
POSTGRES_PASSWORD=kontursvet
# Внешний порт Postgres на хосте
POSTGRES_PORT=5432

# --- Reverse-proxy nginx (точка входа приложения) ---
# Внешний порт на хосте: http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# --- JWT (подпись токенов админки) ---
# Обязателен в проде, минимум 32 символа
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=kontursvet
JWT_AUDIENCE=kontursvet-admin

# --- Мессенджер MAX (отправка лидов) ---
# Заполнить: без них MaxMessageDispatcher не стартует
MAX_TOKEN=
MAX_CHAT_ID=

# --- Nuxt: базовый URL API для браузера ---
# Пусто = относительные /api/** через nginx (рекомендуется)
NUXT_PUBLIC_API_BASE=
