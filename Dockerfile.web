# syntax=docker/dockerfile:1

# ============================================================
# Контекст сборки — корень репозитория (см. docker-compose.*)
#   docker build -f Dockerfile.web --target runtime .
# ============================================================

# ---------- Этап сборки (Node) ----------
FROM node:22-alpine AS build
WORKDIR /app

# Сначала зависимости — слой кэшируется отдельно от исходников
COPY WebApp/package.json WebApp/package-lock.json ./
RUN npm ci

# Затем исходники фронтенда
COPY WebApp/ ./

# Пустой apiBase → фронт ходит по относительным /api/** через nginx
ARG NUXT_PUBLIC_API_BASE=""
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE

RUN npm run build

# ---------- Этап рантайма (прод, Nitro node-server) ----------
FROM node:22-alpine AS runtime
WORKDIR /app

ENV HOST=0.0.0.0 \
    PORT=3000 \
    NODE_ENV=production

# Копируем только серверный бандл Nuxt (.output/server)
COPY --from=build /app/.output ./.output

EXPOSE 3000
CMD ["node", "./.output/server/index.mjs"]
